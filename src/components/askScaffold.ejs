    var current = selectedEffortFor(modelId);
    for (var i = 0; i < list.length; i++) {
      (function(v) {
        var b = document.createElement("button");
        b.type = "button";
        b.setAttribute("role", "option");
        b.setAttribute("data-effort", v);
        b.setAttribute("aria-checked", v === current ? "true" : "false");
        b.textContent = effortDisplayName(v) + (v === current ? " ✓" : "");
        /* #198 Effort 別の強さを行の右に付ける。未計測は `—`。 */
        appendScoreEl(b, effortScoreValue(m, v));
        b.addEventListener("click", function() {
          setEffortFor(modelId, v);
          renderModelButton(selectedModelId() || storeGet(MODEL_KEY) || "");
          renderModelList(selectedModelId() || storeGet(MODEL_KEY) || "");
          closeEffortPopup(true);
        });
        effortList.appendChild(b);
      })(list[i]);
    }
    effortPopup.hidden = false;
    var closeBtn = byId("umeboshi-ask-effort-close");
    if (closeBtn) closeBtn.setAttribute("aria-label", txNow().effortClose);
    var sheet = byId("umeboshi-ask-effort-sheet");
    if (sheet) sheet.setAttribute("aria-label", txNow().effortAria);
  }
  function closeEffortPopup(backToParent) {
    if (!effortPopup || effortPopup.hidden) return;
    effortPopup.hidden = true;
    effortTargetId = "";
    if (backToParent && modelPopup && modelPopup.hidden === false && modelSel) {
      try { modelSel.focus(); } catch (e) {}
    }
  }
  /* ---------- #198 4段階（ModelTier）選択 ----------
     Worker の presets が正。各段は (modelId, effort) の1組で、押すと model＋effort の
     2鍵を書く（段 index は保存しない。選んだ段は2鍵から逆算する）。
     一覧に無い段は出さない。残量不足は押せず理由を1行出す（自動すり替えはしない）。 */
  /* #198 級のアイコン（Material Symbols Outlined）。実体は inline SVG の path で、
     外部フォントは読まない（カードはオフラインでも動く）。school/family_star/diamond/crown。 */
  var TIER_ICON_PATHS = {
    basic: "M480-120 200-272v-240L40-600l440-240 440 240v320h-80v-276l-80 44v240L480-120Zm0-332 274-148-274-148-274 148 274 148Zm0 241 200-108v-151L480-360 280-470v151l200 108Zm0-241Zm0 90Zm0 0Z",
    middle: "M565.5-348.5Q603-377 620-422H340q17 45 54.5 73.5T480-320q48 0 85.5-28.5Zm-143-149Q440-515 440-540t-17.5-42.5Q405-600 380-600t-42.5 17.5Q320-565 320-540t17.5 42.5Q355-480 380-480t42.5-17.5Zm200 0Q640-515 640-540t-17.5-42.5Q605-600 580-600t-42.5 17.5Q520-565 520-540t17.5 42.5Q555-480 580-480t42.5-17.5ZM305-704l112-145q12-16 28.5-23.5T480-880q18 0 34.5 7.5T543-849l112 145 170 57q26 8 41 29.5t15 47.5q0 12-3.5 24T866-523L756-367l4 164q1 35-23 59t-56 24q-2 0-22-3l-179-50-179 50q-5 2-11 2.5t-11 .5q-32 0-56-24t-23-59l4-165L95-523q-8-11-11.5-23T80-570q0-25 14.5-46.5T135-647l170-57Zm49 69-194 64 124 179-4 191 200-55 200 56-4-192 124-177-194-66-126-165-126 165Zm126 135Z",
    premium: "M480-120 80-600l120-240h560l120 240-400 480Zm-95-520h190l-60-120h-70l-60 120Zm55 347v-267H218l222 267Zm80 0 222-267H520v267Zm144-347h106l-60-120H604l60 120Zm-474 0h106l60-120H250l-60 120Z",
    ultra: "M200-160v-80h560v80H200Zm0-140-51-321q-2 0-4.5.5t-4.5.5q-25 0-42.5-17.5T80-680q0-25 17.5-42.5T140-740q25 0 42.5 17.5T200-680q0 7-1.5 13t-3.5 11l125 56 125-171q-11-8-18-21t-7-28q0-25 17.5-42.5T480-880q25 0 42.5 17.5T540-820q0 15-7 28t-18 21l125 171 125-56q-2-5-3.5-11t-1.5-13q0-25 17.5-42.5T820-740q25 0 42.5 17.5T880-680q0 25-17.5 42.5T820-620q-2 0-4.5-.5t-4.5-.5l-51 321H200Zm68-80h424l26-167-105 46-133-183-133 183-105-46 26 167Zm212 0Z",
    /* #198 4級のどれにも入らないモデル用（tune）。 */
    custom: "M440-120v-240h80v80h320v80H520v80h-80Zm-320-80v-80h240v80H120Zm160-160v-80H120v-80h160v-80h80v240h-80Zm160-80v-80h400v80H440Zm160-160v-240h80v80h160v80H680v80h-80Zm-480-80v-80h400v80H120Z"
  };
  var TIER_LABEL_KEYS = { basic: "tierBasic", middle: "tierMiddle", premium: "tierPremium", ultra: "tierUltra" };
  function tierLabelOf(p) {
    var t = txNow();
    var key = p && TIER_LABEL_KEYS[p.tier];
    var s = key ? t[key] : "";
    return (typeof s === "string" && s !== "") ? s : String(p && p.tier);
  }
  function presetEffortOf(p) {
    return (p && typeof p.effort === "string" && p.effort !== "") ? p.effort : "";
  }
  /* #198 行のモデル側。「(Model: effort)」。選択なしモデルは effort を書かない。 */
  function tierModelText(p, m) {
    var s = "(" + modelShortName(m);
    var eff = presetEffortOf(p);
    if (eff !== "") s += ": " + eff;
    return s + ")";
  }
  /* その段がいま選ばれているか。model が一致し、effort は選択中の値と比べる。 */
  function presetIsCurrent(p) {
    if (!p || typeof p.modelId !== "string" || p.modelId === "") return false;
    var mid = selectedModelId();
    if (mid === "" || mid !== p.modelId) return false;
    var m = modelById(mid);
    if (!m) return false;
    return (modelEfforts(m).length > 0 ? selectedEffortFor(mid) : "") === presetEffortOf(p);
  }
  /* #198 モデル一覧の行に付ける級。(modelId, 選び中の effort) が presets の
     どれかに一致すればその級、どれでもなければ Custom（tune アイコン）。
     Opus は premium(high) と ultra(max) の2級に入るので、選び中の effort で決める。 */
  function tierOfModel(m) {
    if (!m) return null;
    var eff = modelEfforts(m).length > 0 ? selectedEffortFor(m.id) : "";
    for (var i = 0; i < cachedPresets.length; i++) {
      var p = cachedPresets[i];
      if (p && p.modelId === m.id && presetEffortOf(p) === eff) return p;
    }
    return null;
  }
  /* 級の見出し（アイコン＋級名）。Custom は tierCustom を出す。 */
  function tierIconSvg(name) {
    return '<svg class="umeboshi-ask-tier-icon-svg" viewBox="0 -960 960 960" aria-hidden="true" focusable="false"><path d="' + String(TIER_ICON_PATHS[name] || TIER_ICON_PATHS.custom) + '"/></svg>';
  }
  function appendTierLabel(btn, tier, modelText, t) {
    var nm = document.createElement("span");
    nm.className = "umeboshi-ask-model-tier";
    nm.innerHTML = tierIconSvg(tier && tier.tier ? tier.tier : "custom");
    var label = document.createElement("span");
    label.className = "umeboshi-ask-model-tier-text";
    label.textContent = tier ? tierLabelOf(tier) : t.tierCustom;
    nm.appendChild(label);
    btn.appendChild(nm);
    var mn = document.createElement("span");
    mn.className = "umeboshi-ask-model-name";
    mn.textContent = "(" + modelText + ")";
    btn.appendChild(mn);
  }
  function renderTierList() {
    if (!tierList) return;
    var t = txNow();
    while (tierList.firstChild) tierList.removeChild(tierList.firstChild);
    var balance = modelBalance();
    var shown = 0;
    for (var i = 0; i < cachedPresets.length; i++) {
      (function(p) {
        if (!p || typeof p.modelId !== "string" || p.modelId === "") return;
        var m = modelById(p.modelId);
        /* 一覧に無い段は出さない（モデル入れ替えで段が宙に浮くのを防ぐ）。 */
        if (!m) return;
        var sel = (balance == null || m.credits == null || m.credits <= balance);
        var b = document.createElement("button");
        b.type = "button";
        b.setAttribute("role", "option");
        b.setAttribute("data-tier", String(p.tier));
        b.setAttribute("data-model-id", p.modelId);
        b.setAttribute("aria-checked", presetIsCurrent(p) ? "true" : "false");
        if (!sel) {
          b.setAttribute("disabled", "disabled");
          b.setAttribute("aria-label", tierLabelOf(p) + " " + tierModelText(p, m) + (t.tierNoBalance ? " " + t.tierNoBalance : ""));
        }
        /* #198 級名はアイコン＋太字、モデル側は (Model: effort) を小さく。 */
        var nm = document.createElement("span");
        nm.className = "umeboshi-ask-tier-name";
        nm.innerHTML = tierIconSvg(p.tier);
        var nmText = document.createElement("span");
        nmText.className = "umeboshi-ask-tier-name-text";
        nmText.textContent = tierLabelOf(p);
        nm.appendChild(nmText);
        b.appendChild(nm);
        var mn = document.createElement("span");
        mn.className = "umeboshi-ask-tier-model";
        mn.textContent = tierModelText(p, m);
        b.appendChild(mn);
        /* #198 目安クレジットは出さない。強さだけ（human 決定）。
           段の effort が有るならその強さ、選択なしモデルはモデル全体の強さ。 */
        var rowScore = presetEffortOf(p) === "" ? modelScore(m) : effortScoreValue(m, presetEffortOf(p));
        appendScoreEl(b, rowScore);
        if (!sel) {
          var nb = document.createElement("span");
          nb.className = "umeboshi-ask-tier-no-balance";
          nb.textContent = t.tierNoBalance || "";
          b.appendChild(nb);
        }
        b.addEventListener("click", function() {
          if (b.disabled) return;
          currentModelId = p.modelId;
          storeSet(MODEL_KEY, p.modelId);
          var eff = presetEffortOf(p);
          if (eff !== "") setEffortFor(p.modelId, eff);
          renderModelButton(p.modelId);
          renderModelList(p.modelId);
          closeTierPopup();
        });
        tierList.appendChild(b);
        shown++;
      })(cachedPresets[i]);
    }
    if (shown === 0) {
      var empty = document.createElement("div");
      empty.className = "umeboshi-ask-note";
      /* presets が無い Worker（デプロイ前）でも「モデルが取れなかった」とは言わない。
         4段階が使えない状態であることを正確に伝える。 */
      empty.textContent = cachedModels.length === 0 ? t.modelsFailOption : t.tierEmpty;
      tierList.appendChild(empty);
    }
  }
  function openTierPopup() {
    if (!tierPopup) return;
    renderTierList();
    if (tierSheetTitle) tierSheetTitle.textContent = txNow().tierTitle;
    if (modelSel) modelSel.setAttribute("aria-expanded", "true");
    tierPopup.hidden = false;
  }
  function closeTierPopup() {
    if (!tierPopup || tierPopup.hidden) return;
    tierPopup.hidden = true;
    if (modelSel) modelSel.setAttribute("aria-expanded", "false");
  }
  function openModelPopup() {
    if (!modelPopup) return;
    renderModelList(selectedModelId() || storeGet(MODEL_KEY) || "");
    modelPopup.hidden = false;
    if (modelSel) modelSel.setAttribute("aria-expanded", "true");
  }
  function closeModelPopup() {
    if (!modelPopup || modelPopup.hidden) return;
    closeEffortPopup(false);
    modelPopup.hidden = true;
    if (modelSel) modelSel.setAttribute("aria-expanded", "false");
  }
  function refreshModelSelectability() {
    if (!modelSel || !cachedModels || cachedModels.length === 0) return;
    renderModelOptions(selectedModelId() || storeGet(MODEL_KEY) || "");
  }
  function switchModelNotice(to) {
    var t = txNow();
    if (statusEl) statusEl.textContent = t.modelSwitched + (to ? ": " + to : "");
  }
  // 読取専用API疎通＋popup結線（失敗しても足場UIは壊さない。#47 native select不使用）
  if (modelSel) {
    modelSel.disabled = true;
    modelSel.textContent = txNow().modelsLoading;
    var savedModel = storeGet(MODEL_KEY) || "";
    currentModelId = savedModel;
    if (modelSel.addEventListener) {
      modelSel.addEventListener("click", function() {
        if (modelSel.disabled) return;
        /* #198 モデルボタンは4段階を開く。従来の一覧は詳細モデル選択の奥。 */
        if (tierPopup && !tierPopup.hidden) closeTierPopup();
        else openTierPopup();
      });
    }
    if (modelCloseBtn && modelCloseBtn.addEventListener) {
      modelCloseBtn.addEventListener("click", function() { closeModelPopup(); });
    }
    if (modelBackBtn && modelBackBtn.addEventListener) {
      /* #198 4段階を閉じてから開く（2枚同時に重ねない）。詳細の奥から1タップで戻れる。 */
      modelBackBtn.addEventListener("click", function() {
        closeModelPopup();
        openTierPopup();
      });
    }
    if (modelBackdrop && modelBackdrop.addEventListener) {
      modelBackdrop.addEventListener("click", function() { closeModelPopup(); });
    }
    if (tierCloseBtn && tierCloseBtn.addEventListener) {
      tierCloseBtn.addEventListener("click", function() { closeTierPopup(); });
    }
    if (tierBackdrop && tierBackdrop.addEventListener) {
      tierBackdrop.addEventListener("click", function() { closeTierPopup(); });
    }
    if (tierDetailBtn && tierDetailBtn.addEventListener) {
      tierDetailBtn.addEventListener("click", function() {
        /* #198 4段階を閉じてから従来のモデル一覧を開く（2枚同時には重ねない）。 */
        closeTierPopup();
        openModelPopup();
      });
    }
    if (effortCloseBtn && effortCloseBtn.addEventListener) {
      /* #198 ✕ は「学習画面に戻る」＝ Effort とモデル一覧を両方閉じる。 */
      effortCloseBtn.addEventListener("click", function() {
        closeEffortPopup(false);
        closeModelPopup();
      });
    }
    if (effortBackBtn && effortBackBtn.addEventListener) {
      /* #198 ← は1つ上（モデル一覧）に戻る。モデル一覧は開いたまま。 */
      effortBackBtn.addEventListener("click", function() { closeEffortPopup(true); });
    }
    if (effortBackdrop && effortBackdrop.addEventListener) {
      effortBackdrop.addEventListener("click", function() { closeEffortPopup(true); });
    }
    if (netFetch()) {
      netFetch()(currentApiBase() + "/api/ask/models").then(function(res) {
        if (!res.ok) throw new Error("bad status " + res.status);
        return res.json();
      }).then(function(body) {
        var list = body && body.models ? body.models : [];
        cachedModels = Object.prototype.toString.call(list) === "[object Array]" ? list : [];
        /* #198 4段階の定義も同じ応答で受け取る。無い Worker は4段階を出さない。 */
        var presets = body && body.presets ? body.presets : [];
        cachedPresets = Object.prototype.toString.call(presets) === "[object Array]" ? presets : [];
        renderModelOptions(savedModel);
        renderTierList();
        var tOk = txNow();
        if (statusEl) statusEl.textContent = cachedModels.length + tOk.modelsAvailable;
      }).catch(function() {
        var tFail = txNow();
        if (statusEl) statusEl.textContent = tFail.modelsFail;
        if (modelSel) { modelSel.textContent = tFail.modelsFailOption; modelSel.disabled = true; }
        cachedModels = [];
        cachedPresets = [];
        renderModelList("");
        renderTierList();
      });
    } else if (statusEl) {
      statusEl.textContent = txNow().modelsFailFetch;
    }
  } else if (netFetch() && statusEl) {
    netFetch()(currentApiBase() + "/api/ask/models").then(function(res) {
      if (!res.ok) throw new Error("bad status " + res.status);
      return res.json();
    }).then(function(body) {
      var n = body && body.models ? body.models.length : 0;
      statusEl.textContent = n + txNow().modelsAvailable;
    }).catch(function() {
      statusEl.textContent = txNow().modelsFail;
    });
  }
})();
</script>
