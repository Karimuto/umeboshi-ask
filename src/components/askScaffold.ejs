  /* #198 強さの記号（🧠＋数字）はモデル一覧・Effort一覧・4段階の3面で同じ見た目に揃える。
     セレクタは3面分を並べる（共通classは Anki の詳細度競合を避けるためID前置を保つ）。 */
  #umeboshi-ask-model-list button .umeboshi-ask-model-score, #umeboshi-ask-effort-list button .umeboshi-ask-model-score, #umeboshi-ask-tier-list button .umeboshi-ask-model-score { flex: none; position: relative; display: inline-flex; align-items: center; justify-content: center; width: 2.2em; height: 2.2em; font-size: 1.15rem; line-height: 1; }
  #umeboshi-ask-model-list button .umeboshi-ask-model-score .umeboshi-ask-model-score-num, #umeboshi-ask-effort-list button .umeboshi-ask-model-score .umeboshi-ask-model-score-num, #umeboshi-ask-tier-list button .umeboshi-ask-model-score .umeboshi-ask-model-score-num { position: absolute; inset: 0; display: flex; align-items: center; justify-content: center; font-size: .62em; font-weight: 900; color: #1B1E24; text-shadow: 0 0 2px #FFFFFF, 0 0 2px #FFFFFF, 1px 0 0 #FFFFFF, -1px 0 0 #FFFFFF, 0 1px 0 0 #FFFFFF, 0 -1px 0 0 #FFFFFF; pointer-events: none; }
  /* #198 未計測は `—`。数字と同じ箱に入れ、読み上げだけを付け替える。 */
  #umeboshi-ask-effort-list button .umeboshi-ask-model-score-unknown, #umeboshi-ask-tier-list button .umeboshi-ask-model-score-unknown { flex: none; color: #5A6472; font-size: .95rem; }
  /* #82 A2: 前半の `button[aria-checked="true"]` は (1,2,1)。175行の
     `button.umeboshi-ask-model-pick` も (1,2,1) で詳細度が同じなので、ソース順で
     後ろの 175行が背景と枠を上書きし、「太字だけ」になっていた。class を含む
     セレクタを足して詳細度を上げ、選択中の白＋梅枠を確実に効かせる。 */
  #umeboshi-ask-model-list button[aria-checked="true"], #umeboshi-ask-model-list button.umeboshi-ask-model-pick[aria-checked="true"] { background: #FFFFFF; border-color: #93233F; font-weight: bold; }
  #umeboshi-ask-model-list button:disabled { opacity: .55; cursor: default; box-shadow: none; }
  /* #66 Effort子popup（親popup内の入れ子・button＋fixed層でAnki WebView対応）。 */
  #umeboshi-ask-effort-popup { position: fixed; inset: 0; z-index: 10001; }
  #umeboshi-ask-effort-popup[hidden] { display: none; }
  #umeboshi-ask-effort-backdrop { position: absolute; inset: 0; background: rgba(27,30,36,.35); backdrop-filter: blur(16px); -webkit-backdrop-filter: blur(16px); }
  #umeboshi-ask-effort-sheet { position: absolute; left: 50%; top: 50%; transform: translate(-50%,-50%); width: min(22rem, 88vw); max-height: 70vh; display: flex; flex-direction: column; background: rgba(255,255,255,.95); border: 1px solid rgba(255,255,255,.9); border-radius: 14px; box-shadow: 0 6px 20px rgba(0,0,0,.18); padding: .6rem .8rem; color: #1B1E24; }
  #umeboshi-ask-effort-sheet-head { display: flex; align-items: center; gap: .5rem; margin-bottom: .4rem; }
  #umeboshi-ask-effort-sheet-head b { flex: 1; font-size: .95rem; }
  #umeboshi-ask .umeboshi-ask-back-btn, #umeboshi-ask #umeboshi-ask-model-back, #umeboshi-ask #umeboshi-ask-effort-back { flex: none; display: inline-flex; align-items: center; justify-content: center; background: #EBE9E7; color: #5A6472; border: 1px solid rgba(255,255,255,.9); border-radius: 9999px; min-width: 44px; min-height: 44px; padding: 0; cursor: pointer; box-shadow: 2px 2px 6px rgba(163,177,198,.55), -2px -2px 6px rgba(255,255,255,.9); }
  #umeboshi-ask #umeboshi-ask-model-back:hover, #umeboshi-ask #umeboshi-ask-effort-back:hover { background: var(--ask-hover); }
  #umeboshi-ask-effort-close { flex: none; background: #EBE9E7; color: #5A6472; border: 1px solid rgba(255,255,255,.9); border-radius: 9999px; min-width: 44px; min-height: 44px; font-size: 1rem; line-height: 1; cursor: pointer; box-shadow: 2px 2px 6px rgba(163,177,198,.55), -2px -2px 6px rgba(255,255,255,.9); }
  #umeboshi-ask-effort-list { overflow-y: auto; display: flex; flex-direction: column; gap: .4rem; }
  #umeboshi-ask-effort-list button { display: block; width: 100%; box-sizing: border-box; text-align: left; background: #EBE9E7; color: #1B1E24; border: 1px solid rgba(255,255,255,.9); border-radius: 10px; padding: .5rem .7rem; font-size: .95rem; line-height: 1.5; min-height: 44px; cursor: pointer; box-shadow: 2px 2px 6px rgba(163,177,198,.55), -2px -2px 6px rgba(255,255,255,.9); }
  #umeboshi-ask-effort-list button[aria-checked="true"] { background: #FFFFFF; border-color: #93233F; font-weight: bold; }
  /* #198 4段階（ModelTier）popup。モデルpopupと同じ button＋fixed層（#47 と同じ理由で
     native UI は使わない）。z-index はモデルpopup(10000)より上にし、詳細モデル選択から
     モデルpopupへ渡すときは必ず閉じてから開く。 */
  #umeboshi-ask-tier-popup { position: fixed; inset: 0; z-index: 10002; }
  #umeboshi-ask-tier-popup[hidden] { display: none; }
  #umeboshi-ask-tier-backdrop { position: absolute; inset: 0; background: rgba(27,30,36,.35); backdrop-filter: blur(16px); -webkit-backdrop-filter: blur(16px); }
  #umeboshi-ask-tier-sheet { position: absolute; left: 50%; top: 50%; transform: translate(-50%,-50%); width: min(24rem, 92vw); max-height: 82vh; display: flex; flex-direction: column; background: rgba(255,255,255,.92); backdrop-filter: blur(16px); -webkit-backdrop-filter: blur(16px); border: 1px solid rgba(255,255,255,.9); border-radius: 14px; box-shadow: 0 6px 20px rgba(0,0,0,.18); padding: .6rem .8rem; color: #1B1E24; }
  #umeboshi-ask-tier-sheet-head { display: flex; align-items: center; gap: .5rem; margin-bottom: .4rem; }
  #umeboshi-ask-tier-sheet-head b { flex: 1; font-size: 1rem; }
  #umeboshi-ask-tier-close { flex: none; background: #EBE9E7; color: #5A6472; border: 1px solid rgba(255,255,255,.9); border-radius: 9999px; min-width: 44px; min-height: 44px; font-size: 1rem; line-height: 1; cursor: pointer; box-shadow: 2px 2px 6px rgba(163,177,198,.55), -2px -2px 6px rgba(255,255,255,.9); }
  #umeboshi-ask-tier-list { overflow-y: auto; display: flex; flex-direction: column; gap: .4rem; }
  /* #198 級名・モデル名・強さ・残高の4点を1行に置く。級名は 4 段の並びを読む軸なので太字。 */
  #umeboshi-ask-tier-list button { display: flex; width: 100%; box-sizing: border-box; text-align: left; align-items: center; gap: .5rem; flex-wrap: wrap; background: #EBE9E7; color: #1B1E24; border: 1px solid rgba(255,255,255,.9); border-radius: 10px; padding: .5rem .7rem; font-size: .95rem; line-height: 1.5; min-height: 44px; cursor: pointer; box-shadow: 2px 2px 6px rgba(163,177,198,.55), -2px -2px 6px rgba(255,255,255,.9); overflow-wrap: anywhere; }
  #umeboshi-ask-tier-list button[aria-checked="true"] { background: #FFFFFF; border-color: #93233F; font-weight: bold; }
  #umeboshi-ask-tier-list button:disabled { opacity: .55; cursor: default; box-shadow: none; }
  #umeboshi-ask-tier-list button:hover:not([aria-checked="true"]):not(:disabled) { background: var(--ask-hover); }
  #umeboshi-ask-tier-list .umeboshi-ask-tier-name { flex: none; display: inline-flex; align-items: center; gap: .35rem; font-weight: 700; }
  #umeboshi-ask-tier-list .umeboshi-ask-tier-name-text { flex: none; }
  #umeboshi-ask-tier-list .umeboshi-ask-tier-model { flex: 1 1 auto; min-width: 0; color: #5A6472; font-size: .78rem; }
  #umeboshi-ask-tier-list .umeboshi-ask-tier-icon-svg { width: 1.3em; height: 1.3em; fill: currentColor; flex: none; }
  #umeboshi-ask-tier-list .umeboshi-ask-tier-no-balance { flex: 1 0 100%; color: #93233F; font-size: .78rem; }
  #umeboshi-ask-tier-foot { display: flex; margin-top: .5rem; }
  #umeboshi-ask-tier-detail-btn { flex: 1; background: #EBE9E7; color: #5A6472; border: 1px solid rgba(255,255,255,.9); border-radius: 10px; padding: .6rem .8rem; font-size: .85rem; line-height: 1.4; min-height: 44px; cursor: pointer; box-shadow: 2px 2px 6px rgba(163,177,198,.55), -2px -2px 6px rgba(255,255,255,.9); }
  #umeboshi-ask-tier-detail-btn:hover { background: var(--ask-hover); }
  /* #250 Copy URL の手運び導線を出す popup。モデルpopup（#47）と同じ button＋fixed層。
     backdrop・sheet・✕ の値はモデルpopupと完全に同じ（スタイルの単一化）。
     z-index は全 popup の上（10003）。 */
  #umeboshi-ask-url-popup { position: fixed; inset: 0; z-index: 10003; }
  #umeboshi-ask-url-popup[hidden] { display: none; }
  #umeboshi-ask-url-backdrop { position: absolute; inset: 0; background: rgba(27,30,36,.35); backdrop-filter: blur(16px); -webkit-backdrop-filter: blur(16px); }
  #umeboshi-ask-url-sheet { position: absolute; left: 50%; top: 50%; transform: translate(-50%,-50%); width: min(28rem, 92vw); max-height: 82vh; display: flex; flex-direction: column; background: rgba(255,255,255,.92); backdrop-filter: blur(16px); -webkit-backdrop-filter: blur(16px); border: 1px solid rgba(255,255,255,.9); border-radius: 14px; box-shadow: 0 6px 20px rgba(0,0,0,.18); padding: .6rem .8rem; color: #1B1E24; }
  #umeboshi-ask-url-sheet-head { display: flex; align-items: center; gap: .5rem; margin-bottom: .4rem; }
  #umeboshi-ask-url-sheet-head b { flex: 1; font-size: 1rem; }
  #umeboshi-ask-url-close { flex: none; background: #EBE9E7; color: #5A6472; border: 1px solid rgba(255,255,255,.9); border-radius: 9999px; min-width: 44px; min-height: 44px; font-size: 1rem; line-height: 1; cursor: pointer; box-shadow: 2px 2px 6px rgba(163,177,198,.55), -2px -2px 6px rgba(255,255,255,.9); }
  /* sheet の中身は 見出し→説明→URL欄→コピー行。隙間は inline の箱（#76）の .35rem を保つ。 */
  #umeboshi-ask-url-note { margin-bottom: .15rem; }
  #umeboshi-ask-url-input { margin-bottom: .35rem; }
  #umeboshi-ask-url-copy-status { flex: 1; min-width: 0; }
  .umeboshi-ask-model-row { display: grid; grid-template-columns: minmax(0, 1fr) 9.5rem; gap: .4rem; align-items: stretch; }
  /* #82 box-sizing を明示する。Anki の `* { box-sizing: content-box }`（詳細度0）で
     width:100% のまま幅がpadding+border分だけ余って Effort ボタンに食い込んだ。 */
  #umeboshi-ask-model-list button.umeboshi-ask-model-pick { flex: none; min-width: 0; width: 100%; box-sizing: border-box; display: flex; flex-wrap: wrap; text-align: left; align-items: center; gap: .5rem; background: #EBE9E7; color: #1B1E24; border: 1px solid rgba(255,255,255,.9); border-radius: 10px; padding: .5rem .7rem; font-size: .95rem; line-height: 1.5; min-height: 44px; cursor: pointer; box-shadow: 2px 2px 6px rgba(163,177,198,.55), -2px -2px 6px rgba(255,255,255,.9); overflow-wrap: anywhere; }
  #umeboshi-ask-model-list button.umeboshi-ask-model-pick .umeboshi-ask-model-name { flex: 1 1 auto; min-width: 0; }
  /* #198 モデル一覧の行の級（アイコン＋級名）とモデル側。tier sheet と同じ形。 */
  #umeboshi-ask-model-list button .umeboshi-ask-model-tier { flex: none; display: inline-flex; align-items: center; gap: .35rem; font-weight: 700; }
  #umeboshi-ask-model-list button .umeboshi-ask-model-tier-text { flex: none; }
  #umeboshi-ask-tier-list .umeboshi-ask-tier-icon-svg, #umeboshi-ask-model-list .umeboshi-ask-tier-icon-svg, .umeboshi-ask-back-svg { width: 1.3em; height: 1.3em; fill: currentColor; flex: none; }
  #umeboshi-ask-model-list button.umeboshi-ask-effort-btn { flex: none; min-width: 0; width: 100%; box-sizing: border-box; display: block; }
  /* #82 Anki の `.isWin button`（0,1,1）と `.fancy button`（0,1,1）は詳細度が
     class 単独（0,1,0）を上回るので、root の ID を前置して (1,1,0) まで上げる。
     実測で font-size 12.8→12px・border-radius 10→0px・box-shadow 差し替えが起きていた。 */
  #umeboshi-ask .umeboshi-ask-effort-btn { background: #EBE9E7; color: #5A6472; border: 1px solid rgba(255,255,255,.9); border-radius: 10px; padding: .5rem .6rem; font-size: .8rem; line-height: 1.4; min-height: 44px; cursor: pointer; box-shadow: 2px 2px 6px rgba(163,177,198,.55), -2px -2px 6px rgba(255,255,255,.9); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  /* #82 A4/C1: model と effort のボタンに :hover が1本も無く、Anki の
     `button:hover { background: var(--button-gradient-start) }` がそのまま出て
     ほぼ黒の矩形になっていた（C1）。選択中と無効は hover を付けない。
     詳細度は Anki の `button:hover` (0,1,1) と `.fancy button:hover` (0,2,1) に勝たせる。 */
  #umeboshi-ask-model-list button.umeboshi-ask-model-pick:hover:not([aria-checked="true"]):not(:disabled) { background: var(--ask-hover); }
  #umeboshi-ask-model-list button.umeboshi-ask-effort-btn:hover:not(:disabled) { background: var(--ask-hover); }
  #umeboshi-ask-effort-list button:hover:not([aria-checked="true"]) { background: var(--ask-hover); }
  .umeboshi-ask-effort-slot-empty { min-width: 0; }
  @media (prefers-reduced-motion: reduce) {
    #umeboshi-ask *, #umeboshi-ask-settings-modal * { animation: none !important; transition: none !important; }
  }
  /* #26: Markdown描画の見た目（表・コード・引用・区切り線）。描画要素はpre-wrapを外す。 */
  /* #215 左揃え: Anki のカードCSS は reviewer 文書に流入し text-align: center を
     持ち込む（#82 で実測した4規則と同じ経路）。パネル側で明示して打ち消す。
     面ごとに指定する（根元一括は送信ヒント等 issue 外の面まで変える）。 */
  .umeboshi-ask-md { overflow-wrap: break-word; text-align: left; }
  .umeboshi-ask-md h1, .umeboshi-ask-md h2, .umeboshi-ask-md h3 { margin: .5rem 0 .3rem; line-height: 1.4; }
  .umeboshi-ask-md h1 { font-size: 1.1rem; }
  .umeboshi-ask-md h2 { font-size: 1.02rem; }
  .umeboshi-ask-md h3 { font-size: .95rem; }
  .umeboshi-ask-md p { margin: .3rem 0; }
  .umeboshi-ask-md ul, .umeboshi-ask-md ol { margin: .3rem 0; padding-left: 1.4rem; }
  .umeboshi-ask-md pre { background: #EBE9E7; border: 1px solid var(--ask-border); border-radius: .4rem; padding: .5rem; overflow-x: auto; margin: .4rem 0; }
  .umeboshi-ask-md pre code { background: none; padding: 0; }
  .umeboshi-ask-md code { background: #EBE9E7; border-radius: .3rem; padding: 0 .3rem; font-family: monospace; }
  .umeboshi-ask-md blockquote { border-left: 3px solid var(--ask-border); margin: .4rem 0; padding: .1rem 0 .1rem .6rem; color: var(--ask-muted); }
  .umeboshi-ask-md hr { border: none; border-top: 1px solid var(--ask-border); margin: .5rem 0; }
  .umeboshi-ask-md table { border-collapse: collapse; display: block; overflow-x: auto; margin: .4rem 0; font-size: .85rem; }
  .umeboshi-ask-md th, .umeboshi-ask-md td { border: 1px solid var(--ask-border); padding: .3rem .5rem; text-align: left; }
  .umeboshi-ask-md th { background: #EBE9E7; }
  /* umeboshi-ask:module:css:c begin */
  /* umeboshi-ask:module:css:c end */
  /* umeboshi-ask:module:css:d begin */
  /* umeboshi-ask:module:css:d end */
  /* ---- S7 設定モーダル: 右スライドイン・ライト限定 ---- */
  #umeboshi-ask-settings-modal {
    position: fixed; inset: 0; z-index: 9999;
    background: rgba(0,0,0,.4);
  }
  #umeboshi-ask-settings-modal[hidden] { display: none; }
  .umeboshi-ask-drawer {
    position: absolute; top: 0; right: 0; bottom: 0;
    width: min(30rem, 94vw);
    background: var(--ask-bg); color: var(--ask-fg);
    border-left: 1px solid var(--ask-border);
    display: flex; flex-direction: column;
    box-shadow: -1rem 0 3rem rgba(0,0,0,.25);
    animation: umeboshi-ask-slidein .3s cubic-bezier(.16,1,.3,1);
  }
  @keyframes umeboshi-ask-slidein { from { transform: translateX(100%); } to { transform: translateX(0); } }
  .umeboshi-ask-head {
    display: flex; align-items: center; gap: .5rem;
    padding: .55rem .7rem; border-bottom: 1px solid var(--ask-border);
  }
  .umeboshi-ask-head h3 { margin: 0; font-size: 1rem; flex: 1; }
  /* ×に一本化：背景と一体化した明るめボタン */
  #umeboshi-ask-settings-close {
    background: transparent; border: none; color: var(--ask-muted);
    font-size: 1.15rem; line-height: 1; padding: .35rem .5rem;
    border-radius: .45rem; cursor: pointer;
    /* #82 Anki の `.fancy button` が box-shadow を足すので、flat 意図を明示する。 */
    box-shadow: none;
  }
  #umeboshi-ask-settings-close:hover { background: var(--ask-hover); color: var(--ask-fg); }
  .umeboshi-ask-search { padding: .5rem .7rem; border-bottom: 1px solid var(--ask-border); }
  .umeboshi-ask-searchrow { display: flex; gap: .4rem; align-items: center; }
  .umeboshi-ask-searchrow input {
    flex: 1; min-width: 0; box-sizing: border-box; padding: .35rem .5rem;
    border: 1px solid var(--ask-border); border-radius: .4rem;
    background: var(--ask-bg); color: var(--ask-fg); font-size: .85rem;
  }
  #umeboshi-ask-search-clear {
    flex: none; background: transparent; border: none; color: var(--ask-muted);
    font-size: 1rem; line-height: 1; padding: .3rem .45rem;
    border-radius: .45rem; cursor: pointer;
  }
  #umeboshi-ask-search-clear:hover { background: var(--ask-hover); color: var(--ask-fg); }
  #umeboshi-ask-search-clear[hidden] { display: none; }
  #umeboshi-ask-search-hint { color: var(--ask-muted); font-size: .75rem; margin-top: .25rem; }
  /* フォルダ型タブ: Activeはパネルと一体化、下辺がつながる。5等幅 */
  .umeboshi-ask-tabs {
    display: flex; gap: .2rem; align-items: stretch;
    padding: .45rem .6rem 0; background: var(--ask-tabstrip-bg);
    border-bottom: 1px solid var(--ask-border);
  }
  .umeboshi-ask-tabs[hidden] { display: none; }
  /* #82 root の ID を前置（(1,1,0)）。Anki の `.isWin button`/`.fancy button` に勝つ。 */
  #umeboshi-ask-settings-modal .umeboshi-ask-tab {
    flex: 1 1 0; min-width: 0;
    border: 1px solid var(--ask-border); border-bottom: none;
    border-radius: .45rem .45rem 0 0;
    background: var(--ask-tab-inactive); color: var(--ask-tab-inactive-fg);
    padding: .35rem .3rem; font-size: .72rem; line-height: 1.3; cursor: pointer;
    margin-bottom: -1px; text-align: center;
    overflow-wrap: anywhere; word-break: break-word;
    box-shadow: none;
  }
  #umeboshi-ask-settings-modal .umeboshi-ask-tab:not(.active):hover { background: var(--ask-hover); }
  #umeboshi-ask-settings-modal .umeboshi-ask-tab.active {
    background: var(--ask-bg); color: var(--ask-fg); font-weight: bold;
    padding-bottom: .5rem; position: relative; z-index: 1;
    box-shadow: none;
  }
  /* 言語ごとのタブ文字サイズ・改行調整フック (data-uilang=表示言語) */
  .umeboshi-ask-drawer[data-uilang="ja"] .umeboshi-ask-tab { font-size: .72rem; }
  .umeboshi-ask-drawer[data-uilang="en"] .umeboshi-ask-tab { font-size: .7rem; }
  .umeboshi-ask-tab-count { font-size: .75em; margin-left: .25em; }
  .umeboshi-ask-body { flex: 1; overflow-y: auto; padding: .5rem .7rem .7rem; display: flex; flex-direction: column; gap: .7rem; }
  .umeboshi-ask-panel[hidden] { display: none; }
  /* ドリルイン: menu-modeは項目行だけ、detail-modeは開いた項目だけ */
  .umeboshi-ask-panel.menu-mode .umeboshi-ask-item { display: none; }
  .umeboshi-ask-panel.detail-mode .umeboshi-ask-menu,
  .umeboshi-ask-panel.detail-mode .umeboshi-ask-note { display: none; }
  .umeboshi-ask-panel.detail-mode .umeboshi-ask-item { display: none; }
  .umeboshi-ask-panel.detail-mode .umeboshi-ask-item.open { display: flex; }
  .umeboshi-ask-menu[hidden] { display: none; }
  /* #82 root の ID を前置（(1,1,0)）。Anki の `.isWin button`/`.fancy button` に勝つ。 */
  #umeboshi-ask-settings-modal .umeboshi-ask-menurow {
    display: flex; width: 100%; box-sizing: border-box;
    min-height: 3.2rem;
    align-items: center; gap: .5rem; text-align: left;
    background: var(--ask-bg); color: var(--ask-fg);
    border: 1px solid var(--ask-border); border-radius: .5rem;
    padding: .5rem .65rem; margin-bottom: .4rem; cursor: pointer; font-size: .87rem;
    box-shadow: none;
  }
  #umeboshi-ask-settings-modal .umeboshi-ask-menurow:hover { border-color: var(--ask-accent); background: var(--ask-hover); }
  #umeboshi-ask-settings-modal .umeboshi-ask-menurow .t { flex: 1; min-width: 0; }
  #umeboshi-ask-settings-modal .umeboshi-ask-menurow .t small { display: block; color: var(--ask-muted); font-size: .75rem; }
  .umeboshi-ask-menurow .chev { color: var(--ask-muted); flex: none; }
