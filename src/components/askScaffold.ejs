  /* umeboshi-ask:module:css:a begin */
  /* umeboshi-ask:module:css:a end */
  .umeboshi-ask-url-input { box-sizing: border-box; width: 100%; min-width: 0; background: #EBE9E7; color: #1B1E24; border: 1px solid rgba(255,255,255,.9); border-radius: .5rem; padding: .5rem .6rem; min-height: 44px; font-size: .78rem; font-family: monospace; box-shadow: inset 2px 2px 5px rgba(163,177,198,.5), inset -2px -2px 5px rgba(255,255,255,.9); }
