  .umeboshi-ask-thread-body .umeboshi-ask-row button:hover, .umeboshi-ask-msg .umeboshi-ask-row button:hover { background: var(--ask-hover); }
  /* umeboshi-ask:module:css:e begin */
  /* umeboshi-ask:module:css:e end */
  /* #250 Copy URL の手運び導線（URL表示＋コピー）はモデル選択と同じ popup にした。
