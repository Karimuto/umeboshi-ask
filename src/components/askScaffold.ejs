  .umeboshi-ask-thread-edit-actions .umeboshi-ask-thread-save { background: #93233F; color: #FFFFFF; border: 1px solid #93233F; border-radius: 9999px; padding: .55rem 1rem; font-size: .8rem; font-weight: 700; line-height: 1.4; min-height: 44px; cursor: pointer; box-shadow: inset 0 1px 0 rgba(255,255,255,.35), 0 4px 10px rgba(0,0,0,.18); }
