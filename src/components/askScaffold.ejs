  .umeboshi-ask-thread-item.is-editing { background: #FFFFFF; border: 1px solid rgba(255,255,255,.9); border-radius: 14px; box-shadow: 0 6px 20px rgba(0,0,0,.10); }
  .umeboshi-ask-thread-edit-label { display: block; font-size: 12px; font-weight: 700; line-height: 1.4; color: #5A6472; margin: .5rem 0 .25rem; }
