  #umeboshi-ask .umeboshi-ask-copy-btn { align-self: flex-start; background: #EBE9E7; color: #5A6472; border: 1px solid rgba(255,255,255,.9); border-radius: 9999px; padding: .45rem .8rem; min-height: 44px; font-size: .85rem; font-weight: 400; line-height: 1.4; cursor: pointer; box-shadow: 2px 2px 6px rgba(163,177,198,.55), -2px -2px 6px rgba(255,255,255,.9); }
