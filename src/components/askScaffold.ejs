    if (tierListEl) tierListEl.setAttribute("aria-label", t.tierAria);
    var tierClose = byId("umeboshi-ask-tier-close");
    if (tierClose) tierClose.setAttribute("aria-label", t.modelClose);
    var tierDetail = byId("umeboshi-ask-tier-detail-btn");
    if (tierDetail) tierDetail.textContent = t.tierDetail;
    /* #198 モデル一覧の「4段階に戻る」。 */
    var modelBack = byId("umeboshi-ask-model-back");
    if (modelBack) modelBack.setAttribute("aria-label", t.modelBack);
    try {
      renderModelButton(selectedModelId() || storeGet(MODEL_KEY) || "");
      renderModelList(selectedModelId() || storeGet(MODEL_KEY) || "");
      if (effortPopup && !effortPopup.hidden && effortTargetId !== "") openEffortPopup(effortTargetId);
      var effortBackEl = byId("umeboshi-ask-effort-back");
      if (effortBackEl) effortBackEl.setAttribute("aria-label", txNow().effortBack);
      /* #198 4段階も言語切替で描き直す。級名は LOCALES 側なので開き直すが必要。 */
      if (tierPopup && !tierPopup.hidden) openTierPopup();
    } catch (eEffort) {}
    var threadTitle = byId("umeboshi-ask-thread-title");
    if (threadTitle) threadTitle.textContent = t.threadTitle;
    var bannerEl = byId("umeboshi-ask-cardid-banner");
    if (bannerEl && !bannerEl.hidden) bannerEl.textContent = t.cardBanner;
    each(qsa('input[name="umeboshi-ask-lang"]'), function(r) {
      r.checked = (r.value === s.lang);
    });
    var langStatus = byId("umeboshi-ask-lang-status");
    if (langStatus) {
      var msg = t.langStatus + det.lang + t.punctOpen + t.langSource + langSourceLabel(det.source, t) + t.punctClose;
      if (det.source === "fallback") msg += t.langFallbackHint;
      langStatus.textContent = msg;
    }
  }

  /* ---------- S7: 質問ボタン描画（既定5＋カスタム無制限） ---------- */
  function renderAskButtons() {
    var s = UmeboshiAskSettings.load();
    var box = byId("umeboshi-ask-buttons");
    if (!box) return;
    each(qsa("#umeboshi-ask-buttons [data-ask-custom]"), function(btn) {
      if (btn.parentNode === box) box.removeChild(btn);
    });
    each(s.customs, function(c) {
      var b = document.createElement("button");
      b.type = "button";
      b.setAttribute("data-ask-custom", c.id);
      b.textContent = c.label || txNow().customName;
      /* #25 単一ゲート: 実送信は questions 委譲に一本化。ここに直接配線しない。 */
      box.appendChild(b);
    });
    applyLang();
  }

  /* ---------- S7: 送信モード → エディタ動作に反映 ---------- */
  function applySendMode() {
    var s = UmeboshiAskSettings.load();
    each(qsa('input[name="umeboshi-ask-sendmode"]'), function(r) {
      r.checked = (r.value === s.sendMode);
    });
    if (sendHint) {
      var tS = txNow();
      sendHint.textContent = (s.sendMode === "enter") ? tS.sendHintEnter : tS.sendHintButton;
    }
    if (inputEl) {
      inputEl.onkeydown = function(e) {
        e = e || root.event;
        var key = e.key || e.keyCode;
        var isEnter = (key === "Enter" || key === 13);
        if (!isEnter) return;
        var mode = UmeboshiAskSettings.load().sendMode;
        if (mode === "enter") {
          if (!e.shiftKey) {
            if (e.preventDefault) e.preventDefault();
            sendBtn.click();
          }
        } else {
          if (e.ctrlKey || e.metaKey) {
            if (e.preventDefault) e.preventDefault();
            sendBtn.click();
          }
        }
      };
    }
  }

  /* ---------- S7: プロンプト編集UI（各エディタが1項目 data-title付き） ---------- */
  function defaultKeyName(k, t) { return t[k] || k; }
  function searchHay(kind, label, body) {
    return "プロンプト prompt " + kind + " " + (label || "") + " " + (body || "");
  }
  function renderPromptEditors() {
    var s = UmeboshiAskSettings.load();
    var det = detectLang(s);
    var t = uiText(det.lang);
    var list = byId("umeboshi-ask-prompt-list");
    if (list) {
      while (list.firstChild) list.removeChild(list.firstChild);
      each(DEFAULT_KEYS, function(k) {
        var wrap = document.createElement("div");
        wrap.className = "umeboshi-ask-item";
        wrap.setAttribute("data-key", k);
        wrap.setAttribute("data-title", defaultKeyName(k, t) + t.promptOf);
        var head = document.createElement("div");
        head.className = "umeboshi-ask-row";
        var title = document.createElement("b");
        title.textContent = defaultKeyName(k, t);
        var spacer = document.createElement("span");
        spacer.style.flex = "1";
        var reset = document.createElement("button");
        reset.type = "button";
        reset.textContent = t.promptReset;
        reset.addEventListener("click", function() {
          var cur = UmeboshiAskSettings.load();
          cur.prompts[k] = { label: "", body: defaultPromptsFor(detectLang(cur).lang)[k] };
          UmeboshiAskSettings.save(cur);
          renderPromptEditors();
          renderAskButtons();
          buildAllMenus();
          reopenDetail();
          refreshSearch();
        });
        head.appendChild(title);
        head.appendChild(spacer);
        head.appendChild(reset);
        var labLabel = document.createElement("label");
        labLabel.textContent = t.promptLabel;
        var labInput = document.createElement("input");
        labInput.type = "text";
        labInput.value = s.prompts[k].label || "";
        labInput.placeholder = defaultKeyName(k, t);
        var bodyLabel = document.createElement("label");
        bodyLabel.textContent = t.promptBody;
        var bodyInput = document.createElement("textarea");
        bodyInput.rows = 4;
        bodyInput.value = s.prompts[k].body;
        labInput.addEventListener("input", function() {
          var cur = UmeboshiAskSettings.load();
          cur.prompts[k].label = labInput.value;
          UmeboshiAskSettings.save(cur);
          wrap.setAttribute("data-search", searchHay(k, labInput.value, bodyInput.value));
          wrap.setAttribute("data-title", (labInput.value || defaultKeyName(k, uiText(detectLang(cur).lang))) + txNow().promptOf);
          renderAskButtons();
          buildAllMenus();
          refreshSearch();
        });
        bodyInput.addEventListener("input", function() {
          if (trim(bodyInput.value) === "") return;
          var cur = UmeboshiAskSettings.load();
          cur.prompts[k].body = bodyInput.value;
          UmeboshiAskSettings.save(cur);
          wrap.setAttribute("data-search", searchHay(k, labInput.value, bodyInput.value));
          refreshSearch();
        });
        wrap.appendChild(head);
        wrap.appendChild(labLabel);
        wrap.appendChild(labInput);
        wrap.appendChild(bodyLabel);
        wrap.appendChild(bodyInput);
        wrap.setAttribute("data-search", searchHay(k, s.prompts[k].label, s.prompts[k].body));
        list.appendChild(wrap);
      });
    }
    var clist = byId("umeboshi-ask-custom-list");
    if (clist) {
      while (clist.firstChild) clist.removeChild(clist.firstChild);
      each(s.customs, function(c) {
        var wrap = document.createElement("div");
        wrap.className = "umeboshi-ask-item";
        wrap.setAttribute("data-custom", c.id);
        wrap.setAttribute("data-title", c.label || t.customName);
        var head = document.createElement("div");
        head.className = "umeboshi-ask-row";
        var title = document.createElement("b");
        title.textContent = c.label || t.customName;
        var spacer = document.createElement("span");
        spacer.style.flex = "1";
        var del = document.createElement("button");
        del.type = "button";
        del.textContent = t.customDelete;
        del.addEventListener("click", function() {
          var cur = UmeboshiAskSettings.load();
          var next = [];
          each(cur.customs, function(x) { if (x.id !== c.id) next.push(x); });
          cur.customs = next;
          UmeboshiAskSettings.save(cur);
          if (openDesc && openDesc.key === c.id) closeDetail();
          renderPromptEditors();
          renderAskButtons();
          buildAllMenus();
          refreshSearch();
        });
        head.appendChild(title);
        head.appendChild(spacer);
        head.appendChild(del);
        var labInput = document.createElement("input");
        labInput.type = "text";
        labInput.value = c.label || "";
        labInput.setAttribute("aria-label", t.customLabelAria);
        var bodyInput = document.createElement("textarea");
        bodyInput.rows = 3;
        bodyInput.value = c.body;
        bodyInput.setAttribute("aria-label", t.customBodyAria);
        labInput.addEventListener("input", function() {
          var cur = UmeboshiAskSettings.load();
          each(cur.customs, function(x) { if (x.id === c.id) x.label = labInput.value; });
          UmeboshiAskSettings.save(cur);
          title.textContent = labInput.value || txNow().customName;
          wrap.setAttribute("data-title", labInput.value || txNow().customName);
          wrap.setAttribute("data-search", searchHay(txNow().customName + " custom", labInput.value, bodyInput.value));
          renderAskButtons();
          buildAllMenus();
          refreshSearch();
        });
        bodyInput.addEventListener("input", function() {
          if (trim(bodyInput.value) === "") return;
          var cur = UmeboshiAskSettings.load();
          each(cur.customs, function(x) { if (x.id === c.id) x.body = bodyInput.value; });
          UmeboshiAskSettings.save(cur);
          wrap.setAttribute("data-search", searchHay(txNow().customName + " custom", labInput.value, bodyInput.value));
          refreshSearch();
        });
        wrap.appendChild(head);
        wrap.appendChild(labInput);
        wrap.appendChild(bodyInput);
        wrap.setAttribute("data-search", searchHay(t.customName + " custom", c.label, c.body));
        clist.appendChild(wrap);
      });
    }
  }

  /* ---------- S7: タブ（フォルダ型）＋ドリルインナビ ---------- */
  function panelEl(name) {
    var panels = qsa("#umeboshi-ask-settings-body .umeboshi-ask-panel");
    for (var i = 0; i < panels.length; i++) {
      if (panels[i].getAttribute("data-panel") === name) return panels[i];
    }
    return null;
  }
  function panelNameOf(item) {
    var p = item.parentNode;
    while (p && !(p.getAttribute && p.getAttribute("data-panel"))) p = p.parentNode;
    return p ? p.getAttribute("data-panel") : null;
  }
  /* 項目の安定キー: openDesc保持・reopenDetail復元・カスタム削除判定に使う。data-key / data-custom が無い静的項目は data-title をキーにする（重複なし想定）。 */
  function itemKey(item) {
    try {
      if (!item || !item.getAttribute) return "";
      var k = item.getAttribute("data-key");
      if (k) return k;
      var c = item.getAttribute("data-custom");
      if (c) return c;
      var t = item.getAttribute("data-title");
      if (t && trim(t) !== "") return trim(t);
    } catch (e) {}
    return "";
  }
  /* #129 表示はUI言語に追従させるので、見出し要素 → <b> → data-title の順に読む。
     data-title は itemKey() のキー（ドリルイン復元）として日本語のまま凍結した。 */
  function itemTitle(item) {
    try {
      if (!item || !item.getAttribute) return txNow().itemFallback;
      if (item.querySelector) {
        var head = item.querySelector(".umeboshi-ask-item-title");
        if (head && head.textContent && trim(head.textContent) !== "") return trim(head.textContent);
        var b = item.querySelector("b");
        if (b && b.textContent && trim(b.textContent) !== "") return trim(b.textContent);
      }
      var t = item.getAttribute("data-title");
      if (t && trim(t) !== "") return trim(t);
    } catch (e) {}
    return txNow().itemFallback;
  }
  function findItem(panel, key) {
    var items = panel.querySelectorAll(".umeboshi-ask-item");
    for (var i = 0; i < items.length; i++) {
      if (itemKey(items[i]) === key) return items[i];
    }
    return null;
  }
  function langNow() { try { return detectLang(UmeboshiAskSettings.load()).lang; } catch (e) { return "ja"; } }
  function txNow() { return uiText(langNow()); }
  function tabNameLocal(name, t) {
    var x = t || txNow();
    if (name === "general") return x.tabGeneral;
    if (name === "prompts") return x.tabPrompts;
    if (name === "lang") return x.tabLang;
    if (name === "account") return x.tabAccount;
    /* "credit" は module（OS5a）が tabNameLocal に足す。 */
    return name;
  }

  function menuRow(title, sub) {
    var b = document.createElement("button");
    b.type = "button";
    b.className = "umeboshi-ask-menurow";
    var span = document.createElement("span");
    span.className = "t";
    span.textContent = title;
    if (sub) {
      var small = document.createElement("small");
      small.textContent = sub;
      span.appendChild(small);
    }
    var chev = document.createElement("span");
    chev.className = "chev";
    chev.textContent = "›";
    b.appendChild(span);
    b.appendChild(chev);
    return b;
  }
  function buildMenu(name) {
    var panel = panelEl(name);
    if (!panel) return;
    var menu = panel.querySelector('[data-menu="' + name + '"]');
    if (!menu) return;
    while (menu.firstChild) menu.removeChild(menu.firstChild);
    each(panel.querySelectorAll(".umeboshi-ask-item"), function(item) {
      var row = menuRow(itemTitle(item), itemSub(item));
      row.addEventListener("click", function() { openDetail(item, "tabs"); });
      menu.appendChild(row);
    });
    if (name === "prompts") {
      var tAdd = txNow();
      var add = menuRow(tAdd.customAdd, tAdd.customNoLimit);
      add.className = add.className + " add";
      add.addEventListener("click", function() { addCustom(); });
      menu.appendChild(add);
    }
  }
  function buildAllMenus() {
    each(TAB_ORDER, function(name) { buildMenu(name); });
  }
  function updateMenuSubs() { buildAllMenus(); }

  function syncTabsUI() {
    each(qsa("#umeboshi-ask-settings-tabs .umeboshi-ask-tab"), function(tab) {
      var on = tab.getAttribute("data-tab") === currentTab;
      if (on) tab.classList.add("active"); else tab.classList.remove("active");
      tab.setAttribute("aria-selected", on ? "true" : "false");
    });
  }
  // タブ一覧表示（項目行モード）
  function showTabs() {
    openDesc = null;
    detailbar.hidden = true;
    resultsEl.hidden = true;
    if (settingsBody) settingsBody.classList.remove("searching");
    if (tabsEl) tabsEl.hidden = false;
    syncTabsUI();
    each(qsa("#umeboshi-ask-settings-body .umeboshi-ask-panel"), function(panel) {
      var on = panel.getAttribute("data-panel") === currentTab;
      panel.hidden = !on;
      panel.classList.remove("detail-mode");
      panel.classList.add("menu-mode");
      each(panel.querySelectorAll(".umeboshi-ask-item"), function(item) {
        item.classList.remove("open");
      });
    });
    if (settingsBody) settingsBody.scrollTop = 0;
  }
  function setTab(name) {
    currentTab = name;
    currentQuery = "";
    if (searchInput) searchInput.value = "";
    var clearBtn = byId("umeboshi-ask-search-clear");
    if (clearBtn) clearBtn.hidden = true;
    if (searchHint) searchHint.textContent = "";
    showTabs();
  }
  // 項目詳細表示（Android式ドリルイン）
  function openDetail(item, from) {
    var panel = panelNameOf(item) ? panelEl(panelNameOf(item)) : null;
    if (!panel) return;
    currentTab = panel.getAttribute("data-panel");
    detailFrom = from;
    openDesc = { panel: currentTab, key: itemKey(item) };
    syncTabsUI();
    if (from === "search") {
      if (tabsEl) tabsEl.hidden = true;
      resultsEl.hidden = true;
    } else {
      if (tabsEl) tabsEl.hidden = false;
      resultsEl.hidden = true;
    }
    each(qsa("#umeboshi-ask-settings-body .umeboshi-ask-panel"), function(p) {
      var on = p === panel;
      p.hidden = !on;
      p.classList.remove("menu-mode");
      p.classList.remove("detail-mode");
      if (on) p.classList.add("detail-mode");
      each(p.querySelectorAll(".umeboshi-ask-item"), function(it) {
        if (it === item) it.classList.add("open"); else it.classList.remove("open");
      });
    });
    var tD = txNow();
    detailSrc.textContent = (from === "search") ? tD.searchResults : tabNameLocal(currentTab);
    detailTitle.textContent = itemTitle(item);
    detailbar.hidden = false;
    if (settingsBody) settingsBody.scrollTop = 0;
  }
  function closeDetail() {
    if (!openDesc) return;
    var from = detailFrom;
    openDesc = null;
    detailbar.hidden = true;
    if (from === "search") {
      runSearch(currentQuery);
    } else {
      showTabs();
    }
  }
  function reopenDetail() {
    if (!openDesc) return;
    var panel = panelEl(openDesc.panel);
    if (!panel) { openDesc = null; return; }
    var item = findItem(panel, openDesc.key);
    if (!item) { openDesc = null; showTabs(); return; }
    openDetail(item, detailFrom);
  }

  /* ---------- S7: 検索 → 結果リスト表示（タップで項目へ） ---------- */
  function collectMatches(q) {
    var out = [];
    each(qsa("#umeboshi-ask-settings-body .umeboshi-ask-item"), function(item) {
      var hay = ((item.getAttribute("data-title") || "") + " " + (item.getAttribute("data-search") || "") + " " + (item.textContent || "")).toLowerCase();
      if (hay.indexOf(q) >= 0) out.push(item);
    });
    return out;
  }
  function runSearch(rawQ) {
    currentQuery = trim(rawQ || "");
    var q = currentQuery.toLowerCase();
    openDesc = null;
    detailbar.hidden = true;
    each(qsa("#umeboshi-ask-settings-tabs .umeboshi-ask-tab-count"), function(el) { el.textContent = ""; });
    if (!searchHint) return;
    if (q === "") {
      if (tabsEl) tabsEl.hidden = false;
      showTabs();
      searchHint.textContent = "";
      return;
    }
    var matches = collectMatches(q);
    var counts = {};
    each(matches, function(item) {
      var pname = panelNameOf(item);
      if (pname) counts[pname] = (counts[pname] || 0) + 1;
    });
    each(qsa("#umeboshi-ask-settings-tabs .umeboshi-ask-tab"), function(tab) {
      var name = tab.getAttribute("data-tab");
      var badge = tab.querySelector(".umeboshi-ask-tab-count");
      if (badge && counts[name]) badge.textContent = "(" + counts[name] + ")";
    });
    if (matches.length === 0) {
      if (tabsEl) tabsEl.hidden = true;
      each(qsa("#umeboshi-ask-settings-body .umeboshi-ask-panel"), function(p) { p.hidden = true; });
      while (resultsEl.firstChild) resultsEl.removeChild(resultsEl.firstChild);
      resultsEl.hidden = false;
      var tN = txNow();
      var qN = searchQuotePair(tN);
      searchHint.textContent = qN.open + currentQuery + qN.close + tN.searchNone;
      return;
    }
    if (tabsEl) tabsEl.hidden = true;
    each(qsa("#umeboshi-ask-settings-body .umeboshi-ask-panel"), function(p) { p.hidden = true; });
    while (resultsEl.firstChild) resultsEl.removeChild(resultsEl.firstChild);
    var tS = txNow();
    each(matches, function(item) {
      var pname = panelNameOf(item);
      var sub = tabNameLocal(pname, tS) || "";
      var isub = itemSub(item);
      if (isub) sub += tS.punctDot + isub;
      var row = menuRow(itemTitle(item), sub);
      row.addEventListener("click", function() { openDetail(item, "search"); });
      resultsEl.appendChild(row);
    });
    resultsEl.hidden = false;
    var names = [];
    var tR = txNow();
    var qR = searchQuotePair(tR);
    for (var k in counts) {
      if (Object.prototype.hasOwnProperty.call(counts, k)) {
        names.push(tabNameLocal(k, tR) + tR.countIn.replace("__N__", String(counts[k])));
      }
    }
    searchHint.textContent = qR.open + currentQuery + qR.close + ": " + names.join(tR.punctDot) + tR.searchFound;
  }
  function refreshSearch() {
    if (!searchInput) return;
    if (trim(searchInput.value) === "") { updateMenuSubs(); return; }
    runSearch(searchInput.value);
  }

  function addCustom() {
    var cur = UmeboshiAskSettings.load();
    var n = cur.customs.length + 1;
    var id = "c" + (new Date().getTime().toString(36)) + n;
    var tC = txNow();
    var langC = langNow();
    cur.customs.push({
      id: id,
      label: tC.customName + n,
      body: langC === "en" ? "About \"{question}\", answer based on the card context.\n\n# Card context\nBody:\n{text}\nCloze info:\n{clozeInfo}\nExtra:\n{extra}" : "「{question}」について、カード文脈を踏まえて答えてください。\n\n# カード文脈\n本文:\n{text}\n穴埋め情報:\n{clozeInfo}\n追加情報:\n{extra}"
    });
    UmeboshiAskSettings.save(cur);
    renderPromptEditors();
    renderAskButtons();
    buildAllMenus();
    currentQuery = "";
    if (searchInput) searchInput.value = "";
    if (searchHint) searchHint.textContent = "";
    setTab("prompts");
  }

  /* ---------- #256 OS2b: 接続先Workerとアクセストークン（自己ホスト導線） ---------- */
  /* URL は http/https の形だけ受け、壊れた値は空（既定に戻す）と見なす。
     トークンは前後空白を落とした形で保存する（中身の検証はWorker側が行う）。 */
  function normalizeWorkerUrl(raw) {
    var s = typeof raw === "string" ? trim(raw) : "";
    if (!s) return "";
    return /^https?:\/\/\S+$/.test(s) ? s : "";
  }
  function readWorkerUrl() {
    try { return normalizeWorkerUrl(storeGet(WORKER_URL_KEY)); } catch (e) { return ""; }
  }
  function readWorkerToken() {
    try { return trim(storeGet(WORKER_TOKEN_KEY) || ""); } catch (e) { return ""; }
  }
  /* 接続先の解決順: 設定の Worker URL > root.UMEBOSHI_ASK_API_BASE（外部フック）
     > 既定の公式 URL（導線維持）。#258 OS2c が全通信の読みをこの順へ寄せる。 */
  function currentApiBase() {
    var set = readWorkerUrl();
    if (set) return set;
    try { if (root && typeof root.UMEBOSHI_ASK_API_BASE === "string" && root.UMEBOSHI_ASK_API_BASE) return root.UMEBOSHI_ASK_API_BASE; } catch (e) {}
    return DEFAULT_API_BASE;
  }
  /* Authorization の優先順位（#258 OS2c で統一）: 設定のアクセストークンが */
  /* あればそれを Bearer に使い、無ければログインのアクセストークン。 */
  /* 設定が空のときは挙動を変えない。login の token は module の閉包が持ち、 */
  /* base は typeof ガードで読口だけを拾う（OS5c #265）。 */
  function bearerToken() {
    try { var set = readWorkerToken(); if (set) return set; } catch (e) {}
    try { if (typeof UmeboshiAskAuthGetToken === "function") { var t = UmeboshiAskAuthGetToken(); if (t) return t; } } catch (e2) {}
    return "";
  }
  /* 保存時の値を入力欄へ戻す。空欄は既定に戻った状態なので空のまま見せる。 */
  function loadConnectionInputs() {
    var urlEl = byId("umeboshi-ask-worker-url");
    if (urlEl) urlEl.value = readWorkerUrl();
    var tokenEl = byId("umeboshi-ask-worker-token");
    if (tokenEl) tokenEl.value = readWorkerToken();
  }
