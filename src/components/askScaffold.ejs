  #umeboshi-ask-model-row { display: flex; gap: .5rem; align-items: center; font-size: .85rem; flex-wrap: wrap; }
  #umeboshi-ask-model { flex: 1; min-width: 0; text-align: left; background: #EBE9E7; color: #1B1E24; border: 1px solid rgba(255,255,255,.9); border-radius: 9999px; padding: .5rem .8rem; min-height: 44px; font-size: .95rem; line-height: 1.5; cursor: pointer; box-shadow: 2px 2px 6px rgba(163,177,198,.55), -2px -2px 6px rgba(255,255,255,.9); overflow-wrap: anywhere; }
